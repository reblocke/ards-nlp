# Copy to .env and fill in local-only settings. Never commit .env files.

GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT=YOUR_GCP_PROJECT
BQ_DATASET=ards_mimic_cxr_benchmark
GCS_BUCKET=YOUR_GCS_BUCKET

# Optional Python CLAMP compatibility mirror. Keep licensed resources outside Git.
ARDS_CLAMP_PROJECT_DIR=data/external/clamp_ards_project
# Set only for a reviewed alternate fingerprint manifest (for example public test fixtures).
ARDS_CLAMP_RESOURCE_MANIFEST=
