# Config (keep the example, ignore the real one)
config/config.yaml
config/annotation_pilot.yaml
config/annotation_planning.yaml
config/external_comparators/*.yaml
!config/external_comparators/*.example.yaml

# Data policy
# - Small example data can be committed.
# - Do not commit real/raw datasets.
# - Put fetched artifacts in data/external/ with *.source.json sidecars.
/physionet.org/
/YOUR_LOCAL_CLAMP_WORKSPACE_ROOT/
/ARDS CLAMP Output.zip
/data/ARDS CLAMP Output.zip
/data/raw/*
!/data/raw/.gitkeep

/data/restricted/*

/data/external/*
!/data/external/.gitkeep

# Derived outputs (generated)
/data/processed/*
!/data/processed/.gitkeep

/data/derived/*
!/data/derived/.gitkeep

/artifacts/*
!/artifacts/.gitkeep

/reports/*
!/reports/.gitkeep

